# Ignore unowned top-level contrib modules by default.  Anchor the rule at this
# directory so editors that honor .gitignore exclusions do not hide the
# explicitly included SatCompute subtree after refreshing the Explorer.
/*

# Include specific files that should be tracked by Git
!/.gitignore
!/satcompute/
!/satcompute/**

# Keep generated Python and experiment output out of the tracked contrib tree.
satcompute/**/__pycache__/
satcompute/**/*.pyc
satcompute/**/.pytest_cache/
satcompute/**/output/

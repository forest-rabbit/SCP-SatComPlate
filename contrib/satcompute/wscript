def build(bld):
    dependencies = [
        'core',
        'network',
        'csma',
        'point-to-point',
        'internet',
        'flow-monitor',
    ]
    module = bld.create_ns3_module('satcompute', dependencies)
    module.source = [
        'para.cc',
        'topology/satellite-topology.cc',
        'topology/snapshot/snapshot-reader.cc',
        'topology/snapshot/snapshot-schedule.cc',
        'topology/link/satellite-link-state.cc',
        'metrics/core/flow-metrics.cc',
        'metrics/core/run-summary.cc',
        'metrics/core/task-metrics.cc',
        'metrics/core/transfer-metrics.cc',
        'metrics/diagnostics/failure-diagnostics.cc',
        'metrics/diagnostics/flow-drop-reason-diagnostics.cc',
        'metrics/metrics.cc',
        'metrics/routing/capacity-aware-metrics.cc',
        'metrics/routing/ecmp-metrics.cc',
        'metrics/routing/ecmp-route-recorder.cc',
        'metrics/routing/size-aware-metrics.cc',
        'routing/capacity-aware-route-admission.cc',
        'routing/satcompute-ipv4-global-routing.cc',
        'routing/satcompute-ipv4-global-routing-helper.cc',
        'routing/size-aware-flow-registry.cc',
        'task/compute-profile.cc',
        'task/compute-service.cc',
        'task/compute-task.cc',
        'task/task-coordinator.cc',
        'task/task-trace.cc',
        'traffic/network-transfer.cc',
        'traffic/network-transfer-application.cc',
        'traffic/network-transfer-config.cc',
        'traffic/network-transfer-engine.cc',
        'traffic/network-transfer-receiver.cc',
    ]

    headers = bld(features='ns3header')
    headers.module = 'satcompute'
    headers.source = ['para.h']

    program = bld.create_ns3_program(
        'satcompute',
        ['satcompute'])
    program.source = ['satcompute.cc']

    route_audit = bld.create_ns3_program(
        'satcompute-route-candidate-audit',
        ['satcompute'])
    route_audit.source = [
        'tools/analysis/topology_interval/route-candidate-audit.cc',
    ]

    route_selection_audit = bld.create_ns3_program(
        'satcompute-route-selection-audit',
        ['satcompute'])
    route_selection_audit.source = [
        'tools/analysis/topology_interval/route-selection-audit.cc',
    ]

    topology_cost_audit = bld.create_ns3_program(
        'satcompute-topology-cost-audit',
        ['satcompute'])
    topology_cost_audit.source = [
        'tools/analysis/topology_interval/topology-cost-audit.cc',
    ]

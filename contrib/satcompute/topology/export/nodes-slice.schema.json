{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forest-rabbit.github.io/SCP-SatComPlate/schemas/topology-nodes-slice-0.2.json",
  "title": "SatCompute topology node slice 0.2",
  "description": "One deterministic evaluation of all circular-orbit satellite positions at an exact simulation time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "simulation_time_ns",
    "state_semantics",
    "coordinate_frame",
    "coordinate_units",
    "node_count",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "description": "Topology trace contract version.",
      "const": "0.2"
    },
    "simulation_time_ns": {
      "description": "Exact simulation time represented as signed 64-bit integer nanoseconds.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "state_semantics": {
      "description": "The slice evaluates orbit positions and topology policy at this trace time; it does not assert that the live network was reconfigured at this time.",
      "const": "orbit-policy-evaluation"
    },
    "coordinate_frame": {
      "description": "Earth-centred, Earth-fixed Cartesian coordinate frame.",
      "const": "ECEF"
    },
    "coordinate_units": {
      "description": "Unit used by x_m, y_m, and z_m.",
      "const": "m"
    },
    "node_count": {
      "description": "Number of entries in nodes.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "nodes": {
      "description": "Satellite positions sorted by stable external node ID.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "description": "One stable satellite identity and ECEF position.",
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "x_m", "y_m", "z_m"],
      "properties": {
        "node_id": {
          "description": "Stable unsigned satellite ID equal to plane times satellites_per_orbit plus slot.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "node_type": {
          "description": "Satellite node discriminator.",
          "const": "sat"
        },
        "x_m": {
          "description": "ECEF x coordinate in metres.",
          "type": "number"
        },
        "y_m": {
          "description": "ECEF y coordinate in metres.",
          "type": "number"
        },
        "z_m": {
          "description": "ECEF z coordinate in metres.",
          "type": "number"
        }
      }
    }
  }
}
